WORKFLOW_DIR=/home/lshpk18/dual_rnaseq_timecourse_workflow
DE_DIR=/home/lshpk18/dual_rnaseq_timecourse_workflow

# User input files. Edit these paths before running on a new dataset.
HOST_FEATURECOUNTS=/home/lshpk18/dual_rnaseq_timecourse_workflow/data/featurecounts/featureCounts_host.txt
BACTERIA_FEATURECOUNTS=/home/lshpk18/dual_rnaseq_timecourse_workflow/data/featurecounts/featureCounts_bacteria.txt
METADATA_TABLE=/home/lshpk18/dual_rnaseq_timecourse_workflow/data/metadata/sample_metadata.tsv
HOST_BAM_DIR=/home/lshpk18/dual_rnaseq_timecourse_workflow/data/bam/host
BACTERIA_BAM_DIR=/home/lshpk18/dual_rnaseq_timecourse_workflow/data/bam/bacteria
HOST_ANNOTATION=/home/lshpk18/dual_rnaseq_timecourse_workflow/references/host.gtf
BACTERIA_ANNOTATION=/home/lshpk18/dual_rnaseq_timecourse_workflow/references/pathogen.gff3
BACTERIA_FASTA=/home/lshpk18/dual_rnaseq_timecourse_workflow/references/pathogen.fasta

# Timepoint policy. Use 60m in metadata; 1h/60min are automatically repaired to 60m.
REQUIRED_TIMEPOINTS=0h,15m,30m,60m,3h,24h

# Analysis parameters.
CONDA_ENV_DESEQ2=dualrnaseq_deseq2
CONDA_ENV_PATHWAY=dualrnaseq_pathway
PADJ=0.05
LFC=1
THREADS=16
