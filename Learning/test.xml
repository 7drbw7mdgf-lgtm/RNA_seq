<svg width="1200" height="1500" viewBox="0 0 1200 1500" xmlns="[w3.org](http://www.w3.org/2000/svg)">
  <defs>
    <style>
      .title {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 30px;
        font-weight: 700;
        fill: #1f2937;
      }

      .section-title {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 18px;
        font-weight: 700;
        fill: #111827;
      }

      .box-title {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        font-weight: 700;
        fill: #111827;
      }

      .box-text {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        fill: #374151;
      }

      .small-text {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        fill: #4b5563;
      }

      .arrow-label {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 12px;
        fill: #374151;
        font-weight: 600;
      }

      .install {
        fill: #e0f2fe;
        stroke: #0284c7;
        stroke-width: 2;
      }

      .input {
        fill: #fef3c7;
        stroke: #d97706;
        stroke-width: 2;
      }

      .process {
        fill: #ecfdf5;
        stroke: #059669;
        stroke-width: 2;
      }

      .slurm {
        fill: #ede9fe;
        stroke: #7c3aed;
        stroke-width: 2;
      }

      .output {
        fill: #fce7f3;
        stroke: #db2777;
        stroke-width: 2;
      }

      .visual {
        fill: #fff7ed;
        stroke: #ea580c;
        stroke-width: 2;
      }

      .group {
        fill: none;
        stroke: #cbd5e1;
        stroke-width: 2;
        stroke-dasharray: 8 6;
      }

      .arrow {
        stroke: #374151;
        stroke-width: 2.5;
        fill: none;
        marker-end: url(#arrowhead);
      }

      .arrow-soft {
        stroke: #6b7280;
        stroke-width: 2;
        fill: none;
        marker-end: url(#arrowhead-soft);
        stroke-dasharray: 6 5;
      }
    </style>

    <marker id="arrowhead" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#374151"/>
    </marker>

    <marker id="arrowhead-soft" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
      <path d="M0,0 L10,4 L0,8 Z" fill="#6b7280"/>
    </marker>

    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#000000" flood-opacity="0.15"/>
    </filter>
  </defs>

  <rect width="1200" height="1500" fill="#f8fafc"/>

  <text x="600" y="55" text-anchor="middle" class="title">
    Bioinformatics Pipeline Workflow: Script Relationships
  </text>

  <text x="600" y="85" text-anchor="middle" class="small-text">
    RNA-seq / dual RNA-seq workflow from dependency installation to trimming, QC, alignment, post-alignment analysis, and visualisation
  </text>

  <!-- Installation group -->
  <rect x="70" y="120" width="1060" height="210" rx="18" class="group"/>
  <text x="95" y="150" class="section-title">1. Dependency and environment setup</text>

  <rect x="100" y="175" width="195" height="105" rx="12" class="install" filter="url(#shadow)"/>
  <text x="197.5" y="200" text-anchor="middle" class="box-title">install_fastp.sh</text>
  <text x="120" y="225" class="box-text">Creates/uses rna-seq env</text>
  <text x="120" y="245" class="box-text">Installs fastp</text>
  <text x="120" y="265" class="box-text">Tests installation</text>

  <rect x="315" y="175" width="220" height="105" rx="12" class="install" filter="url(#shadow)"/>
  <text x="425" y="200" text-anchor="middle" class="box-title">install_qc_dependencies.sh</text>
  <text x="335" y="225" class="box-text">Installs FastQC + MultiQC</text>
  <text x="335" y="245" class="box-text">Prefers mamba/micromamba</text>
  <text x="335" y="265" class="box-text">Uses rna-seq env</text>

  <rect x="555" y="175" width="195" height="105" rx="12" class="install" filter="url(#shadow)"/>
  <text x="652.5" y="200" text-anchor="middle" class="box-title">install_graphviz.sh</text>
  <text x="575" y="225" class="box-text">Installs Graphviz</text>
  <text x="575" y="245" class="box-text">Uses conda-forge</text>
  <text x="575" y="265" class="box-text">Supports diagrams</text>

  <rect x="770" y="175" width="230" height="105" rx="12" class="install" filter="url(#shadow)"/>
  <text x="885" y="200" text-anchor="middle" class="box-title">install_allignment_dependancies.sh</text>
  <text x="790" y="225" class="box-text">Creates dualrnaseq env</text>
  <text x="790" y="245" class="box-text">Installs STAR, samtools</text>
  <text x="790" y="265" class="box-text">Installs subread + Python</text>

  <rect x="430" y="295" width="340" height="70" rx="12" class="install" filter="url(#shadow)"/>
  <text x="600" y="320" text-anchor="middle" class="box-title">install_visualisation.sh</text>
  <text x="455" y="345" class="box-text">Creates Python venv with plotly, matplotlib, seaborn, pandas, numpy, jupyter</text>

  <!-- Inputs -->
  <rect x="110" y="420" width="260" height="90" rx="12" class="input" filter="url(#shadow)"/>
  <text x="240" y="448" text-anchor="middle" class="box-title">Raw paired FASTQ files</text>
  <text x="135" y="475" class="box-text">Input: *_R1_001.fastq.gz</text>
  <text x="135" y="495" class="box-text">Input: *_R2_001.fastq.gz</text>

  <rect x="830" y="420" width="260" height="90" rx="12" class="input" filter="url(#shadow)"/>
  <text x="960" y="448" text-anchor="middle" class="box-title">Reference resources</text>
  <text x="855" y="475" class="box-text">Host and bacterial genomes</text>
  <text x="855" y="495" class="box-text">Annotation files for counting</text>

  <!-- Trimming and QC group -->
  <rect x="70" y="560" width="1060" height="300" rx="18" class="group"/>
  <text x="95" y="590" class="section-title">2. Read trimming and pre-alignment QC</text>

  <rect x="145" y="625" width="310" height="120" rx="12" class="process" filter="url(#shadow)"/>
  <text x="300" y="655" text-anchor="middle" class="box-title">trim_fastp.sh</text>
  <text x="170" y="682" class="box-text">Checks FASTQ directory</text>
  <text x="170" y="702" class="box-text">Finds R1/R2 pairs</text>
  <text x="170" y="722" class="box-text">Runs fastp trimming per sample</text>

  <rect x="515" y="625" width="310" height="120" rx="12" class="output" filter="url(#shadow)"/>
  <text x="670" y="655" text-anchor="middle" class="box-title">Trimmed outputs</text>
  <text x="540" y="682" class="box-text">*_R1_trimmed.fastq.gz</text>
  <text x="540" y="702" class="box-text">*_R2_trimmed.fastq.gz</text>
  <text x="540" y="722" class="box-text">fastp HTML and JSON reports</text>

  <rect x="515" y="780" width="310" height="70" rx="12" class="process" filter="url(#shadow)"/>
  <text x="670" y="807" text-anchor="middle" class="box-title">run_multiqc_trimmed.sh</text>
  <text x="540" y="832" class="box-text">Aggregates fastp reports into MultiQC summary</text>

  <rect x="875" y="780" width="200" height="70" rx="12" class="output" filter="url(#shadow)"/>
  <text x="975" y="807" text-anchor="middle" class="box-title">Trimmed QC report</text>
  <text x="900" y="832" class="box-text">MultiQC output + log</text>

  <!-- Alignment group -->
  <rect x="70" y="910" width="1060" height="340" rx="18" class="group"/>
  <text x="95" y="940" class="section-title">3. Dual RNA-seq alignment and count generation</text>

  <rect x="120" y="980" width="280" height="100" rx="12" class="slurm" filter="url(#shadow)"/>
  <text x="260" y="1008" text-anchor="middle" class="box-title">submit_dual_rnaseq_slurm.sh</text>
  <text x="145" y="1035" class="box-text">Simple SLURM wrapper</text>
  <text x="145" y="1055" class="box-text">Activates dualrnaseq env</text>

  <rect x="460" y="980" width="280" height="100" rx="12" class="slurm" filter="url(#shadow)"/>
  <text x="600" y="1008" text-anchor="middle" class="box-title">dual_rnaseq_workflow.sbatch</text>
  <text x="485" y="1035" class="box-text">Configurable SLURM job</text>
  <text x="485" y="1055" class="box-text">STEP=index / align / counts / all</text>

  <rect x="290" y="1130" width="330" height="95" rx="12" class="process" filter="url(#shadow)"/>
  <text x="455" y="1158" text-anchor="middle" class="box-title">dual_rnaseq_workflow.sh</text>
  <text x="315" y="1185" class="box-text">Core workflow called by SLURM wrappers</text>
  <text x="315" y="1205" class="box-text">Runs STAR, samtools, subread/featureCounts</text>

  <rect x="700" y="1130" width="330" height="95" rx="12" class="output" filter="url(#shadow)"/>
  <text x="865" y="1158" text-anchor="middle" class="box-title">Alignment outputs</text>
  <text x="725" y="1185" class="box-text">BAM files, indexes, logs</text>
  <text x="725" y="1205" class="box-text">Count tables, alignment QC outputs</text>

  <!-- Post alignment group -->
  <rect x="70" y="1300" width="1060" height="115" rx="18" class="group"/>
  <text x="95" y="1330" class="section-title">4. Post-alignment analysis and visualisation</text>

  <rect x="170" y="1355" width="300" height="70" rx="12" class="slurm" filter="url(#shadow)"/>
  <text x="320" y="1382" text-anchor="middle" class="box-title">post_alignment_analysis.sbatch</text>
  <text x="195" y="1407" class="box-text">Wraps post_alignment_analysis.sh with resumable flags</text>

  <rect x="520" y="1355" width="260" height="70" rx="12" class="output" filter="url(#shadow)"/>
  <text x="650" y="1382" text-anchor="middle" class="box-title">Final processed results</text>
  <text x="545" y="1407" class="box-text">Summaries, QC tables, count matrices</text>

  <rect x="830" y="1355" width="240" height="70" rx="12" class="visual" filter="url(#shadow)"/>
  <text x="950" y="1382" text-anchor="middle" class="box-title">Visualisation</text>
  <text x="855" y="1407" class="box-text">Jupyter, plotly, matplotlib, seaborn</text>

  <!-- Arrows -->
  <path d="M197.5 280 C197.5 340 220 365 235 420" class="arrow-soft"/>
  <path d="M425 280 C425 345 350 375 300 625" class="arrow-soft"/>
  <path d="M652.5 280 C650 340 700 365 950 1355" class="arrow-soft"/>
  <path d="M885 280 C890 380 850 460 730 980" class="arrow-soft"/>
  <path d="M600 365 C650 600 780 1050 950 1355" class="arrow-soft"/>

  <path d="M370 465 L455 465 C485 465 500 650 515 680" class="arrow"/>
  <text x="410" y="452" class="arrow-label">input reads</text>

  <path d="M455 685 L515 685" class="arrow"/>
  <text x="465" y="675" class="arrow-label">fastp</text>

  <path d="M670 745 L670 780" class="arrow"/>
  <text x="690" y="765" class="arrow-label">QC reports</text>

  <path d="M825 815 L875 815" class="arrow"/>
  <text x="835" y="803" class="arrow-label">MultiQC</text>

  <path d="M670 745 C640 850 560 990 500 1130" class="arrow"/>
  <text x="565" y="900" class="arrow-label">trimmed reads</text>

  <path d="M960 510 C960 740 880 970 865 1130" class="arrow"/>
  <text x="905" y="875" class="arrow-label">references + annotations</text>

  <path d="M400 1030 L460 1030" class="arrow"/>
  <text x="413" y="1018" class="arrow-label">alternative wrapper</text>

  <path d="M600 1080 C580 1100 545 1115 505 1130" class="arrow"/>
  <path d="M260 1080 C300 1110 340 1125 390 1130" class="arrow"/>

  <path d="M620 1178 L700 1178" class="arrow"/>
  <text x="632" y="1166" class="arrow-label">align + count</text>

  <path d="M865 1225 C820 1295 520 1315 370 1355" class="arrow"/>
  <text x="590" y="1300" class="arrow-label">BAMs, counts, QC inputs</text>

  <path d="M470 1390 L520 1390" class="arrow"/>
  <path d="M780 1390 L830 1390" class="arrow"/>

  <!-- Legend -->
  <rect x="75" y="1450" width="1050" height="35" rx="8" fill="#ffffff" stroke="#e5e7eb"/>
  <rect x="100" y="1462" width="18" height="12" class="install"/>
  <text x="125" y="1473" class="small-text">Install/setup</text>

  <rect x="235" y="1462" width="18" height="12" class="input"/>
  <text x="260" y="1473" class="small-text">Input/reference</text>

  <rect x="390" y="1462" width="18" height="12" class="process"/>
  <text x="415" y="1473" class="small-text">Processing script</text>

  <rect x="555" y="1462" width="18" height="12" class="slurm"/>
  <text x="580" y="1473" class="small-text">SLURM wrapper</text>

  <rect x="705" y="1462" width="18" height="12" class="output"/>
  <text x="730" y="1473" class="small-text">Output/result</text>

  <rect x="855" y="1462" width="18" height="12" class="visual"/>
  <text x="880" y="1473" class="small-text">Visualisation</text>
</svg>


